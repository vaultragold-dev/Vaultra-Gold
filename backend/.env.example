# 1-Click Cloud App Builder (GitHub Actions)
GITHUB_REPO=vaultragold-dev/Vaultra-Gold
GITHUB_REF=main
GITHUB_TOKEN=
# Public HTTPS origin baked into every branded app and store kit (must be https:// for store builds).
# Leave empty to use the host the Master panel was opened on. ALLOW_HTTP_BUILD=1 only for throwaway test APKs.
PUBLIC_BASE_URL=https://master.vaultragold.com
ALLOW_HTTP_BUILD=0
# App Studio creates each jeweller's Android keystore automatically and saves it (and connected Apple keys) as
# GitHub secrets, so GITHUB_TOKEN needs "Secrets: Read and write" + "Actions: Read and write" on this repo.
# Optional: STORE_SECRETS_KEY (Fernet key) encrypts the server-side keystore backups; defaults to a key derived
# from JWT_SECRET - never change JWT_SECRET/STORE_SECRETS_KEY afterwards or the backups cannot be decrypted.
# Store signing/upload credentials live as GitHub Actions secrets (see KIT README / App Studio "Store account key"):
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD, PLAY_SERVICE_ACCOUNT_JSON,
#   APPLE_TEAM_ID, ASC_KEY_ID, ASC_ISSUER_ID, ASC_API_KEY_P8_BASE64  (+ "_<KEY>" suffix per jeweller)

# Optional AWS S3 Storage (falls back to backend/uploads/ on disk if empty)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
